package ui

import "fmt"
import "routeworkbench/internal/maps"

templ Icon(name string, size int) {
	<svg width={ Number(size) } height={ Number(size) } viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><use href={ "/assets/icons.svg#" + name }></use></svg>
}

templ Page(v View) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>路线查询 · 多目的地路线工作台</title>
			<meta name="description" content="切换出发地，比较多个目的地的路线和预计耗时"/>
			<link rel="stylesheet" href="/assets/styles.css"/><script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body>
			<main class="route-app" id="route-app" hx-include="#workspace-meta" hx-target="#updates" hx-swap="innerHTML">
				<form id="workspace-meta" hidden><input type="hidden" name="workspace" value={ v.Workspace }/><input type="hidden" name="csrf" value={ v.CSRF }/></form>
				<div id="route-sync" hidden></div>
				<div id="editor-sync" hidden></div>
				<div id="updates" hidden></div>
				<header class="app-header">
					<div class="brand">
						@Icon("Path", 46)
						<h1>路线查询</h1>
					</div>
					<p class="brand-subtitle">切换出发地，查看多目的地路线</p>
					<div class="header-actions">
						<details class="provider-control">
							<summary class="provider-trigger">
								<span>地图服务：</span><strong>高德</strong>@Icon("CaretDown", 16)
							</summary>
							<div class="provider-menu">
								<p class="menu-caption">地图来源</p>
								<button type="button" disabled>
									@Icon("MapTrifold", 20)
									<span><strong>高德</strong><small>真实地图、地点搜索与路线规划</small></span>@Icon("Check", 18)
								</button><button type="button" disabled><span><strong>百度</strong><small>尚未接入</small></span></button><button type="button" disabled><span><strong>开源方案</strong><small>尚未接入</small></span></button>
							</div>
						</details>
						<button type="button" class="demo-badge live-status" data-open-help>
							<span class="status-dot" id="map-status-dot"></span><span id="map-status">连接中</span>@Icon("Info", 14)
						</button>
					</div>
				</header>
				<div id="origins">@Origins(v)</div>
				<div id="search">@Search(v)</div>
				<div id="preferences">@Preferences(v)</div>
				<section class="map-workspace" aria-label="高德路线地图">
					<div class="map-canvas" id="route-map" role="application" aria-label="高德地图，可拖动或使用缩放按钮"></div>
					<div id="map-loading" class="map-state-message" role="status">
						@Icon("SpinnerGap", 28)
						<span>正在加载高德地图…</span>
					</div>
					<div id="picker-banner">@Picker(v)</div>
					<div class="map-empty-message" id="map-empty">先搜索地点，或在地图上选点</div>
					<div class="map-controls">
						<button type="button" class="fit-button" id="map-fit" title="显示全部地点" aria-label="显示全部地点">
							@Icon("ArrowsOut", 24)
						</button>
						<div class="zoom-controls">
							<button type="button" id="map-zoom-in" aria-label="放大地图">
								@Icon("Plus", 25)
							</button>
							<button type="button" id="map-zoom-out" aria-label="缩小地图">
								@Icon("Minus", 25)
							</button>
						</div>
					</div>
				</section>
				<div id="route-options">@Options(v)</div>
				<div id="results" aria-live="polite">@Results(v)</div>
				<footer class="app-footer">
					<span>数据来源：高德地图 · 耗时为查询时的预估</span>
					<button type="button" data-open-help>
						@Icon("Info", 15)
						<span>使用说明</span>
					</button>
				</footer>
				<div id="modal">@Modal(v)</div>
				<div id="notice" aria-live="polite">@Notice(v)</div>
				<dialog class="app-dialog" id="help-dialog">
					<div class="dialog-heading">
						<h2>路线查询使用说明</h2>
						<button type="button" class="icon-button" data-close-help aria-label="关闭窗口">
							@Icon("X", 21)
						</button>
					</div>
					<p>搜索或在地图上选点，设置一个出发地和多个目的地。点击顶部页签切换出发地，目的地保持不变。</p>
					<p>自行车与电动车分别规划。点击目的地耗时，选择高德返回的备选路线，地图和表格同步更新。</p>
					<p>驾车默认高德推荐，也可选择躲避拥堵、速度优先、少收费或不走高速。预计耗时受道路、班次和服务覆盖范围影响。</p>
					<p>地点保留在当前页面会话中，刷新后清空。百度与开源方案尚未接入。</p>
					<div class="dialog-actions"><button type="button" class="primary-button" data-close-help>知道了</button></div>
				</dialog>
			</main>
		</body>
	</html>
}

templ Origins(v View) {
	<section class="origin-toolbar" aria-label="出发地管理">
		<span class="toolbar-label">出发地</span>
		<div class="origin-tabs" role="tablist" aria-label="选择出发地">
			for _,p := range v.Origins {
				<div class={ "origin-tab-wrap", templ.KV("active",p.ID==v.ActiveID) }>
					<button type="button" role="tab" class="origin-tab" aria-selected={ fmt.Sprint(p.ID == v.ActiveID) } title={ p.Address } hx-post="/ui/activate-origin" hx-vals={ Values("id", p.ID) } hx-sync="#route-sync:replace">{ p.Name }</button>
					if p.ID==v.ActiveID {
						<div class="origin-tab-actions">
							<button type="button" class="icon-button" aria-label={ "编辑" + p.Name } hx-post="/ui/open-editor" hx-vals={ Values("kind", "origin", "id", p.ID) } hx-sync="#editor-sync:replace">
								@Icon("PencilSimple", 18)
							</button>
							<button
								type="button"
								class="icon-button"
								aria-label={ "删除" + p.Name }
								hx-post="/ui/delete-place"
								hx-vals={ Values("kind", "origin", "id", p.ID) }
								hx-sync="#route-sync:replace"
							>
								@Icon("X", 18)
							</button>
						</div>
					}
				</div>
			}
			if len(v.Origins)==0 {
				<span class="no-origin-label">搜索地点，或添加一个出发地</span>
			}
		</div>
		<button type="button" class="text-button add-origin" disabled?={ !v.WebConfigured } hx-post="/ui/open-editor" hx-vals={ Values("kind", "origin") } hx-sync="#editor-sync:replace">
			@Icon("Plus", 21)
			添加出发地
		</button>
	</section>
}

templ Search(v View) {
	<form class="search-toolbar" hx-post="/ui/submit" hx-sync="#route-sync:replace" hx-indicator="#query-indicator">
		<div class="search-combobox">
			@Icon("MagnifyingGlass", 25)
			<input
				name="query"
				id="origin-search"
				aria-label="搜索出发地"
				placeholder="搜索出发地，建议加上城市名"
				value={ v.Query }
				maxlength="100"
				disabled?={ !v.WebConfigured }
				autocomplete="off"
				data-active-name={ activeName(v) }
			/>
			if v.SearchOpen {
				<div class="search-options" role="listbox">
					<div class="search-options-caption">选择准确的出发位置</div>
					for i,p := range v.Search {
						<button type="button" role="option" aria-selected="false" hx-post="/ui/select-origin" hx-vals={ Values("choice", Number(i)) } hx-sync="#route-sync:replace">
							@Icon("MapPin", 18)
							<span class="place-result-copy"><strong>{ p.Name }</strong><small>{ p.Address }</small></span>
						</button>
					}
					if len(v.Search)==0 {
						<p class="search-empty">没有找到地点，换个名称或加上城市再试。</p>
					}
				</div>
			}
		</div>
		<div class="search-help"><span>搜索地点，或</span><button type="button" disabled?={ !v.MapConfigured||!v.WebConfigured } hx-post="/ui/start-pick" hx-vals={ Values("quick", "true") } hx-sync="#editor-sync:replace">在地图上选点</button></div>
		<button type="submit" class="primary-button query-button" disabled?={ !v.WebConfigured }>
			<span class="htmx-indicator" id="query-indicator">
				@Icon("SpinnerGap", 20)
			</span>
			<span id="query-button-text">
				if v.Active()!=nil {
					查询路线
				} else {
					搜索地点
				}
			</span>
		</button>
	</form>
}

func activeName(v View) string {
	if p := v.Active(); p != nil {
		return p.Name
	}
	return ""
}

templ Preferences(v View) {
	<section class="driving-preferences" aria-label="驾车路线偏好">
		<label for="driving-policy">
			@Icon("Car", 20)
			驾车偏好
		</label>
		<select id="driving-policy" name="policy" hx-post="/ui/policy" hx-trigger="change" hx-sync="#route-sync:replace">
			for _,p := range Policies {
				<option value={ Number(p.ID) } selected?={ v.Policy==p.ID }>{ p.Name }</option>
			}
		</select>
		<p>点击目的地耗时，可选择高德返回的备选路线</p>
	</section>
}

templ Results(v View) {
	<section class="results-section" aria-label="目的地路线查询结果" aria-busy={ fmt.Sprint(v.Dirty) } aria-live="polite">
		<div class="results-heading">
			<h2>目的地与耗时</h2>
			<p>点击时长，查看并选择路线</p>
			<button type="button" class="text-button add-destination" disabled?={ !v.WebConfigured } hx-post="/ui/open-editor" hx-vals={ Values("kind", "destination") } hx-sync="#editor-sync:replace">
				@Icon("Plus", 21)
				添加目的地
			</button>
		</div>
		<div class="results-table-scroll">
			<table class="results-table">
				<thead>
					<tr>
						<th scope="col" class="destination-column">目的地</th>
						for _,mode := range Modes {
							<th scope="col">
								<span class="mode-heading">
									@Icon(mode.Icon, 25)
									{ mode.Name }
								</span>
							</th>
						}
						<th scope="col" class="actions-column"><span class="sr-only">地点操作</span></th>
					</tr>
				</thead>
				<tbody>
					for index,p := range v.Destinations {
						<tr class={ templ.KV("focused-row", v.FocusID == p.ID) }>
							<th scope="row"><button type="button" class="destination-name" title={ p.Address } hx-post="/ui/select-mode" hx-vals={ Values("id", p.ID, "mode", p.Mode) }><span class="destination-letter" style={ "background:" + p.ColorValue() }>{ Letter(index) }</span><span>{ p.Name }</span></button></th>
							for _,mode := range Modes {
								<td>@TimeCell(v, p, mode)</td>
							}
							<td class="row-actions">
								<button type="button" class="icon-button" aria-label={ "编辑" + p.Name } hx-post="/ui/open-editor" hx-vals={ Values("kind", "destination", "id", p.ID) } hx-sync="#editor-sync:replace">
									@Icon("PencilSimple", 21)
								</button>
								<button
									type="button"
									class="icon-button"
									aria-label={ "删除" + p.Name }
									hx-post="/ui/delete-place"
									hx-vals={ Values("kind", "destination", "id", p.ID) }
									hx-sync="#route-sync:replace"
								>
									@Icon("X", 21)
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(v.Destinations)==0 {
			<div class="destinations-empty">
				@Icon("MapPin", 29)
				<h3>添加一个目的地</h3>
				<p>设置出发地和目的地后，比较不同出行方式的真实路线与预计耗时。</p>
				<button
					type="button"
					class="primary-button"
					disabled?={ !v.WebConfigured }
					hx-post="/ui/open-editor"
					hx-vals={ Values("kind", "destination") }
					hx-sync="#editor-sync:replace"
				>
					@Icon("Plus", 18)
					添加目的地
				</button>
			</div>
		}
		if !v.WebConfigured {
			<p class="mode-availability-note">地图查询服务尚未完成配置。</p>
		}
		if v.Dirty&&v.CanQuery() {
			<div class="query-loader" hx-post="/ui/query" hx-trigger="load" hx-sync="#route-sync:replace" role="status">
				@Icon("SpinnerGap", 17)
				<span>正在查询路线…</span>
			</div>
		}
		if v.QueriedAt!="" {
			<p class="query-timestamp">查询时间：{ v.QueriedAt } · 高德预计耗时</p>
		}
	</section>
}

templ TimeCell(v View, p Place, mode Mode) {
	<button type="button" class={ CellClass(p.Mode == mode.ID, v.Cell(p.ID, mode.ID)) } style={ "--route-color:" + p.ColorValue() + ";--route-tint:" + p.ColorValue() + "20" } disabled?={ !v.Cell(p.ID,mode.ID).Success() } aria-pressed={ fmt.Sprint(p.Mode == mode.ID && v.Cell(p.ID, mode.ID).Success()) } aria-label={ p.Name + "，" + mode.Name + "，" + TimeLabel(v.Cell(p.ID, mode.ID)) } title={ CellTitle(v.Cell(p.ID, mode.ID)) } hx-post="/ui/select-mode" hx-vals={ Values("id", p.ID, "mode", mode.ID) }>
		if p.Mode==mode.ID&&v.Cell(p.ID,mode.ID).Success() {
			@Icon("Check", 21)
		}
		<span>{ TimeLabel(v.Cell(p.ID,mode.ID)) }</span>
	</button>
	if v.Cell(p.ID,mode.ID).Status=="error" {
		<small class="cell-error-message">{ v.Cell(p.ID,mode.ID).Reason }</small>
	}
}

templ Options(v View) {
	if v.PanelPlace()!=nil&&v.PanelResult().Success() {
		<section class="route-options-panel" aria-label={ v.PanelPlace().Name + "的备选路线" }>
			<div class="route-options-heading">
				<div>
					<h2>
						{ v.PanelPlace().Name }
						<span>
							· { v.PanelModeValue().Name }
							if v.PanelMode=="driving" {
								· { v.PolicyName() }
							}
						</span>
					</h2>
					<p>
						if len(v.PanelResult().Alternatives)>1 {
							共 { Number(len(v.PanelResult().Alternatives)) } 条可选路线，点击后在地图上查看
						} else {
							高德本次仅返回 1 条可用路线
						}
					</p>
				</div>
				<button type="button" class="icon-button" aria-label="收起备选路线" hx-post="/ui/close-options">
					@Icon("X", 20)
				</button>
			</div>
			<div class="route-option-cards">
				for _,route := range v.PanelResult().Alternatives {
					<button type="button" class={ "route-option-card",templ.KV("active",RouteSelected(v.PanelResult(),route.ID)) } aria-pressed={ fmt.Sprint(RouteSelected(v.PanelResult(), route.ID)) } hx-post="/ui/select-route" hx-vals={ Values("id", v.PanelID, "mode", v.PanelMode, "route", route.ID) }>
						<span class="route-option-title">
							方案 { Number(route.Index+1) }
							if RouteSelected(v.PanelResult(),route.ID) {
								@Icon("Check", 18)
							}
						</span><strong>{ Number(route.Minutes) }<span>分钟</span></strong>
						<span class="route-option-metrics">
							{ maps.DistanceLabel(route.Distance) }
							if route.Tolls!=nil {
								· 过路费约 { fmt.Sprintf("%.0f",*route.Tolls) } 元
							}
						</span>
						<small>
							if route.Summary!="" {
								{ route.Summary }
							} else {
								高德返回的规划路线
							}
						</small>
					</button>
				}
			</div>
		</section>
	}
}

templ Modal(v View) {
	if v.Editor!=nil&&!v.Picking {
		<dialog class="app-dialog" id="place-dialog" data-editor>
			<div class="dialog-heading">
				<h2>{ v.Editor.Title() }</h2>
				<button type="button" class="icon-button" aria-label="关闭窗口" hx-post="/ui/close-editor">
					@Icon("X", 21)
				</button>
			</div>
			<form id="place-form" hx-post="/ui/save-place" hx-sync="#editor-sync:replace">
				<label class="form-label" for="place-search">搜索真实地点</label>
				<div class="dialog-search live-search">
					@Icon("MagnifyingGlass", 19)
					<input name="query" id="place-search" value={ v.Editor.Query } maxlength="100" autocomplete="off" placeholder="输入地点，建议加上城市名" data-search-on-enter/>
					<button type="button" hx-post="/ui/search-editor" hx-include="#workspace-meta, #place-form" hx-sync="#editor-sync:replace" hx-disabled-elt="this">
						搜索
						<span class="htmx-indicator">…</span>
					</button>
				</div>
				<div class="place-choices" aria-label="高德地点搜索结果">
					for i,p := range v.Editor.Choices {
						<button type="button" class={ "place-choice",templ.KV("selected",v.Editor.Selected!=nil&&v.Editor.Selected.Point==p.Point) } hx-post="/ui/select-place" hx-include="#workspace-meta, #place-form" hx-vals={ Values("choice", Number(i)) }>
							@Icon("MapPin", 19)
							<span class="place-result-copy"><strong>{ p.Name }</strong><small>{ p.Address }</small></span>
							if v.Editor.Selected!=nil&&v.Editor.Selected.Point==p.Point {
								@Icon("Check", 18)
							}
						</button>
					}
					if len(v.Editor.Choices)==0 {
						<p class="search-empty">
							if v.Editor.Searched {
								没有找到地点，换个名称或加上城市再试。
							} else {
								搜索后选择准确地址，也可以在地图上选点。
							}
						</p>
					}
				</div>
				<button type="button" class="map-pick-action" hx-post="/ui/start-pick" hx-include="#workspace-meta, #place-form">
					@Icon("Crosshair", 19)
					在地图上选点
					@Icon("ArrowRight", 17)
				</button>
				if v.Editor.Selected!=nil {
					<div class="chosen-position live-chosen">
						@Icon("Check", 16)
						<span>已选择：{ v.Editor.Selected.Name }<small>{ v.Editor.Selected.Address }</small></span>
					</div>
				}
				<label class="form-label" for="place-name">显示名称 <span class="optional-label">可选</span></label><input class="form-input" id="place-name" name="name" value={ v.Editor.Name } maxlength="32" placeholder="留空使用地点名称"/>
				if v.Editor.Error!="" {
					<p class="form-error" role="alert">{ v.Editor.Error }</p>
				}
				<div class="dialog-actions">
					<button type="button" class="secondary-button" hx-post="/ui/close-editor">取消</button>
					<button type="submit" class="primary-button">
						if v.Editor.ID!="" {
							保存修改
						} else {
							添加{ v.Editor.KindName() }
						}
					</button>
				</div>
			</form>
		</dialog>
	}
}

templ Picker(v View) {
	if v.Picking {
		<div class="pick-banner" role="status">
			@Icon("Crosshair", 18)
			<span>{ pickLabel(v) }</span><button type="button" hx-post="/ui/cancel-pick" hx-sync="#editor-sync:replace">取消选点</button>
		</div>
	}
}

templ Notice(v View) {
	if v.Toast!="" {
		<div class="toast" role="status">
			@Icon("Info", 18)
			<span>{ v.Toast }</span>
			if v.CanUndo {
				<button type="button" hx-post="/ui/undo" hx-sync="#route-sync:replace">撤销</button>
			}
			<button type="button" class="icon-button" aria-label="关闭提示" hx-post="/ui/dismiss-toast">
				@Icon("X", 16)
			</button>
		</div>
	}
}

templ Updates(v View, targets []string) {
	for _,target := range targets {
		<div id={ target } hx-swap-oob="outerHTML">
			switch target {
				case "origins":
					@Origins(v)
				case "search":
					@Search(v)
				case "preferences":
					@Preferences(v)
				case "results":
					@Results(v)
				case "route-options":
					@Options(v)
				case "modal":
					@Modal(v)
				case "picker-banner":
					@Picker(v)
				case "notice":
					@Notice(v)
			}
		</div>
	}
}
