package ui

import "fmt"
import "jicheng/internal/maps"

templ Icon(name string, size int) {
	<svg width={ Number(size) } height={ Number(size) } viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><use href={ "/assets/icons.svg#" + name }></use></svg>
}

templ Page(v View) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>几程 · 多起点多终点地图</title>
			<meta name="application-name" content="几程"/>
			<meta name="description" content="几程：在地图上设置多个起点和终点，切换起点比较路线与耗时。把远近，换成时间。"/>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body>
			<main class="route-app" id="route-app" hx-include="#workspace-meta" hx-target="#updates" hx-swap="innerHTML">
				<form id="workspace-meta" hidden><input type="hidden" name="workspace" value={ v.Workspace }/><input type="hidden" name="csrf" value={ v.CSRF }/></form>
				<div id="route-sync" hidden></div>
				<div id="editor-sync" hidden></div>
				<div id="search-sync" hidden></div>
				<div id="updates" hidden></div>
				<section class="map-workspace" aria-label="高德路线地图">
					<div class="map-canvas" id="route-map" role="application" aria-label="高德地图，点击地点可设为起点或终点"></div>
					<div id="map-loading" class="map-state-message" role="status">
						@Icon("SpinnerGap", 28)
						<span>正在加载地图…</span>
					</div>
				</section>
				<header class="app-header">
					<div class="brand">
						@Icon("Path", 32)
						<div><h1>几程</h1><span>把远近，换成时间</span></div>
					</div>
					<div class="header-actions">
						<div class="live-status"><span class="status-dot" id="map-status-dot"></span><strong>高德地图</strong><span id="map-status">连接中</span></div>
						<button type="button" class="help-button" data-open-help aria-label="使用说明">
							@Icon("Info", 22)
						</button>
					</div>
				</header>
				<button type="button" class="panel-toggle" id="panel-toggle" aria-controls="route-sidebar" aria-expanded="true" hidden>
					@Icon("Path", 20)
					<span>路线与耗时</span><span id="place-count"></span>
				</button>
				<aside class="route-sidebar" id="route-sidebar" aria-label="起点终点与路线" hidden>
					<div class="sidebar-heading">
						<div><h2>路线与耗时</h2><p>切换起点，比较到各个终点的时间</p></div>
						<button type="button" class="icon-button" data-collapse-panel aria-label="收起路线面板">
							@Icon("Minus", 20)
						</button>
					</div>
					<div id="origins">
						@Origins(v)
					</div>
					<div id="preferences">
						@Preferences(v)
					</div>
					<div class="sidebar-scroll">
						<div id="route-options">
							@Options(v)
						</div>
						<div id="results" aria-live="polite">
							@Results(v)
						</div>
					</div>
				</aside>
				<div class="map-controls">
					<button type="button" id="map-fit" title="显示全部地点" aria-label="显示全部地点">
						@Icon("ArrowsOut", 22)
					</button>
					<button type="button" id="map-zoom-in" aria-label="放大地图">
						@Icon("Plus", 24)
					</button>
					<button type="button" id="map-zoom-out" aria-label="缩小地图">
						@Icon("Minus", 24)
					</button>
				</div>
				<div id="picker-banner">
					@Picker(v)
				</div>
				<div class="search-dock">
					<div id="search">
						@Search(v)
					</div>
				</div>
				<div id="modal">
					@Modal(v)
				</div>
				<div id="notice" aria-live="polite">
					@Notice(v)
				</div>
				<dialog class="app-dialog" id="help-dialog">
					<div class="dialog-heading">
						<h2>几程使用说明</h2>
						<button type="button" class="icon-button" data-close-help aria-label="关闭窗口">
							@Icon("X", 21)
						</button>
					</div>
					<p>在下方搜索一个地点，点选搜索结果，再选择“设为起点”或“设为终点”。也可以直接点击地图选点。</p>
					<p>可以添加多个起点和多个终点。每次选中一个起点，所有起点共用终点列表；切换起点后自动更新路线和耗时。</p>
					<p>点击终点卡片中的交通方式，查看距离、预计耗时和可选路线。各个终点独立规划，不是依次途经。</p>
					<p>自行车与电动车分别查询。驾车可选择高德推荐、躲避拥堵等偏好。预计耗时受道路、班次和服务覆盖范围影响。</p>
					<p>地点保留在当前页面会话中，刷新后清空。数据来源：高德地图。</p>
					<div class="dialog-actions"><button type="button" class="primary-button" data-close-help>知道了</button></div>
				</dialog>
			</main>
		</body>
	</html>
}

templ Origins(v View) {
	<section class="origins-section" data-place-count={ Number(len(v.Origins) + len(v.Destinations)) } aria-label="起点管理">
		<div class="section-caption">
			<span>起点 <b>{ Number(len(v.Origins)) }</b></span>
			<button type="button" class="text-button" data-search-focus disabled?={ !v.WebConfigured } aria-label="搜索并添加起点">
				@Icon("Plus", 16)
				添加
			</button>
		</div>
		<div class="origin-tabs" role="tablist" aria-label="选择起点">
			for _,p := range v.Origins {
				<button type="button" role="tab" class={ "origin-tab",templ.KV("active",p.ID==v.ActiveID) } aria-selected={ fmt.Sprint(p.ID == v.ActiveID) } title={ p.Address } hx-post="/ui/activate-origin" hx-vals={ Values("id", p.ID) } hx-sync="#route-sync:replace">
					@Icon("MapPin", 15)
					<span>{ p.Name }</span>
				</button>
			}
		</div>
		if v.Active()!=nil {
			<div class="active-origin">
				<span title={ v.Active().Address }>{ v.Active().Address }</span>
				<button type="button" class="icon-button" aria-label={ "编辑起点" + v.Active().Name } hx-post="/ui/open-editor" hx-vals={ Values("kind", "origin", "id", v.ActiveID) } hx-sync="#editor-sync:replace">
					@Icon("PencilSimple", 16)
				</button>
				<button type="button" class="icon-button" aria-label={ "删除起点" + v.Active().Name } hx-post="/ui/delete-place" hx-vals={ Values("kind", "origin", "id", v.ActiveID) } hx-sync="#route-sync:replace">
					@Icon("X", 16)
				</button>
			</div>
		} else {
			<p class="section-empty">搜索一个地点，将它设为起点</p>
		}
	</section>
}

templ Search(v View) {
	<div class="search-content" data-search-open={ fmt.Sprint(v.SearchOpen || v.Preview != nil) }>
		if v.Preview!=nil {
			<section class="place-preview" aria-label="地点详情">
				<div class="preview-heading">
					<span>地点详情</span>
					<button type="button" class="icon-button" aria-label="关闭地点详情" hx-post="/ui/clear-search" hx-sync="#search-sync:replace">
						@Icon("X", 19)
					</button>
				</div>
				<h2>{ v.Preview.Name }</h2>
				<p>{ v.Preview.Address }</p>
				<div class="preview-actions">
					<button type="button" class="primary-button" hx-post="/ui/assign-place" hx-vals={ Values("kind", "origin") } hx-sync="#route-sync:replace" hx-disabled-elt="this">
						@Icon("MapPin", 18)
						设为起点
					</button>
					<button type="button" class="secondary-button" hx-post="/ui/assign-place" hx-vals={ Values("kind", "destination") } hx-sync="#route-sync:replace" hx-disabled-elt="this">
						@Icon("Path", 19)
						设为终点
					</button>
				</div>
				if len(v.Search)>0 {
					<button type="button" class="text-button back-results" hx-post="/ui/back-search" hx-sync="#search-sync:replace">返回搜索结果</button>
				}
			</section>
		} else if v.SearchOpen {
			<section class="search-results" aria-label="地点搜索结果">
				<div class="preview-heading">
					<span>搜索结果 <b>{ Number(len(v.Search)) }</b></span>
					<button type="button" class="icon-button" aria-label="关闭搜索结果" hx-post="/ui/clear-search" hx-sync="#search-sync:replace">
						@Icon("X", 19)
					</button>
				</div>
				<div class="search-options">
					for i,p := range v.Search {
						<button type="button" class="place-choice" hx-post="/ui/inspect-place" hx-vals={ Values("choice", Number(i)) } hx-sync="#search-sync:replace">
							@Icon("MapPin", 22)
							<span class="place-result-copy"><strong>{ p.Name }</strong><small>{ p.Address }</small></span>
							@Icon("ArrowRight", 18)
						</button>
					}
					if v.SearchError!="" {
						<p class="form-error" role="alert">{ v.SearchError }</p>
					} else if len(v.Search)==0 {
						<p class="search-empty">没有找到地点，试试加上城市名或在地图上选点。</p>
					}
				</div>
			</section>
		} else if len(v.Origins)==0&&len(v.Destinations)==0&&!v.Picking {
			<div class="search-intro"><strong>从一个地点开始</strong><span>搜索或点击地图，设为起点或终点</span></div>
		}
		<form class="search-toolbar" hx-post="/ui/submit" hx-sync="#search-sync:replace" hx-indicator="#query-indicator" hx-disabled-elt="find button[type=submit]">
			<label for="place-query" class="search-icon">
				@Icon("MagnifyingGlass", 24)
				<span class="sr-only">搜索地点</span>
			</label>
			<input id="place-query" name="query" aria-label="搜索地点" placeholder="搜索地点，设为起点或终点" value={ v.Query } maxlength="100" disabled?={ !v.WebConfigured } autocomplete="off" required/>
			<button type="button" class="pick-button" title="在地图上选点" aria-label="在地图上选点" disabled?={ !v.MapConfigured||!v.WebConfigured } hx-post="/ui/start-pick" hx-vals={ Values("quick", "true") } hx-sync="#search-sync:replace">
				@Icon("Crosshair", 22)
			</button>
			<button type="submit" class="primary-button query-button" disabled?={ !v.WebConfigured }>
				<span class="htmx-indicator" id="query-indicator">
					@Icon("SpinnerGap", 18)
				</span><span>搜索</span>
			</button>
		</form>
		if !v.WebConfigured {
			<p class="configuration-note">地点查询服务尚未完成配置</p>
		}
	</div>
}

templ Preferences(v View) {
	<div class="driving-preferences">
		<label for="driving-policy">
			@Icon("Car", 17)
			驾车偏好
		</label>
		<select id="driving-policy" name="policy" aria-label="驾车偏好" hx-post="/ui/policy" hx-trigger="change" hx-sync="#route-sync:replace">
			for _,p := range Policies {
				<option value={ Number(p.ID) } selected?={ v.Policy==p.ID }>{ p.Name }</option>
			}
		</select>
		<button type="button" class="icon-button refresh-routes" title="重新查询路线" aria-label="重新查询路线" disabled?={ !v.CanQuery()||v.Dirty } hx-post="/ui/refresh-routes" hx-sync="#route-sync:replace">
			@Icon("Path", 19)
		</button>
	</div>
}

templ Results(v View) {
	<section class="results-section" aria-label="终点与耗时" aria-busy={ fmt.Sprint(v.Dirty) }>
		<div class="section-caption">
			<span>终点 <b>{ Number(len(v.Destinations)) }</b></span>
			<button type="button" class="text-button" data-search-focus disabled?={ !v.WebConfigured } aria-label="搜索并添加终点">
				@Icon("Plus", 16)
				添加
			</button>
		</div>
		if len(v.Destinations)==0 {
			<div class="destinations-empty">
				@Icon("Path", 32)
				<h3>下一站，去哪里？</h3>
				<p>在下方搜索地点，选择“设为终点”<br/>即可比较五种出行方式的耗时</p>
				<button type="button" class="text-button" data-search-focus disabled?={ !v.WebConfigured }>
					搜索一个终点
					@Icon("ArrowRight", 16)
				</button>
			</div>
		}
		for index,p := range v.Destinations {
			<article class={ "destination-card",templ.KV("focused-row",v.FocusID==p.ID) } style={ "--route-color:" + p.ColorValue() }>
				<div class="destination-heading">
					<span class="destination-letter">{ Letter(index) }</span>
					<div><h3>{ p.Name }</h3><p title={ p.Address }>{ p.Address }</p></div>
					<button type="button" class="icon-button" aria-label={ "编辑终点" + p.Name } hx-post="/ui/open-editor" hx-vals={ Values("kind", "destination", "id", p.ID) } hx-sync="#editor-sync:replace">
						@Icon("PencilSimple", 16)
					</button>
					<button type="button" class="icon-button" aria-label={ "删除终点" + p.Name } hx-post="/ui/delete-place" hx-vals={ Values("kind", "destination", "id", p.ID) } hx-sync="#route-sync:replace">
						@Icon("X", 16)
					</button>
				</div>
				<div class="mode-times">
					for _,mode := range Modes {
						@TimeCell(v, p, mode)
					}
				</div>
				if v.Active()==nil {
					<p class="destination-note">添加一个起点后，自动查询路线</p>
				} else if v.Cell(p.ID,p.Mode).Success() {
					<p class="destination-note">{ maps.DistanceLabel(v.Cell(p.ID,p.Mode).Selected().Distance) }<span>点击耗时，查看路线方案</span></p>
				}
			</article>
		}
		if v.Dirty&&v.CanQuery() {
			<div class="query-loader" hx-post="/ui/query" hx-trigger="load" hx-sync="#route-sync:replace" role="status">
				@Icon("SpinnerGap", 16)
				<span>正在查询各个终点的路线…</span>
			</div>
		}
		if v.QueriedAt!="" {
			<p class="query-timestamp">{ v.QueriedAt } 更新 · 高德预计耗时</p>
		}
	</section>
}

templ TimeCell(v View, p Place, mode Mode) {
	{{ result := v.Cell(p.ID, mode.ID) }}
	<div class="mode-time">
		<button type="button" class={ CellClass(p.Mode == mode.ID, result) } disabled?={ !result.Success() } aria-pressed={ fmt.Sprint(p.Mode == mode.ID && result.Success()) } aria-label={ p.Name + "，" + mode.Name + "，" + TimeLabel(result) } title={ CellTitle(result) } hx-post="/ui/select-mode" hx-vals={ Values("id", p.ID, "mode", mode.ID) }>
			@Icon(mode.Icon, 21)
			<span class="mode-name">{ mode.Name }</span>
			if result.Success() {
				<strong class="duration"><span class="duration-number">{ Number(result.Selected().Minutes) }</span><span class="duration-unit"> 分钟</span></strong>
			} else {
				<strong class="duration-status">{ TimeLabel(result) }</strong>
			}
		</button>
		if result.Status == "error" {
			<span class="sr-only">{ result.Reason }</span>
		}
	</div>
}

templ Options(v View) {
	if v.PanelPlace()!=nil&&v.PanelResult().Success() {
		<section class="route-options-panel" data-route-detail aria-label={ v.PanelPlace().Name + "的备选路线" }>
			<div class="route-options-heading">
				<div>
					<h2>
						{ v.PanelPlace().Name }
						<span>
							· { v.PanelModeValue().Name }
							if v.PanelMode=="driving" {
								· { v.PolicyName() }
							}
						</span>
					</h2>
					<p>
						if len(v.PanelResult().Alternatives)>1 {
							共 { Number(len(v.PanelResult().Alternatives)) } 条可选路线，点击后在地图上查看
						} else {
							高德本次仅返回 1 条可用路线
						}
					</p>
				</div>
				<button type="button" class="icon-button" aria-label="返回全部终点" hx-post="/ui/close-options">
					@Icon("ArrowRight", 20)
				</button>
			</div>
			<div class="route-option-cards">
				for _,route := range v.PanelResult().Alternatives {
					<button type="button" class={ "route-option-card",templ.KV("active",RouteSelected(v.PanelResult(),route.ID)) } aria-pressed={ fmt.Sprint(RouteSelected(v.PanelResult(), route.ID)) } hx-post="/ui/select-route" hx-vals={ Values("id", v.PanelID, "mode", v.PanelMode, "route", route.ID) }>
						<span class="route-option-title">
							方案 { Number(route.Index+1) }
							if RouteSelected(v.PanelResult(),route.ID) {
								@Icon("Check", 18)
							}
						</span><strong>{ Number(route.Minutes) }<span>分钟</span></strong>
						<span class="route-option-metrics">
							{ maps.DistanceLabel(route.Distance) }
							if route.Tolls!=nil {
								· 过路费约 { fmt.Sprintf("%.0f",*route.Tolls) } 元
							}
						</span>
						<small>
							if route.Summary!="" {
								{ route.Summary }
							} else {
								高德返回的规划路线
							}
						</small>
					</button>
				}
			</div>
		</section>
	}
}

templ Modal(v View) {
	if v.Editor!=nil&&!v.Picking {
		<dialog class="app-dialog" id="place-dialog" data-editor>
			<div class="dialog-heading">
				<h2>{ v.Editor.Title() }</h2>
				<button type="button" class="icon-button" aria-label="关闭窗口" hx-post="/ui/close-editor">
					@Icon("X", 21)
				</button>
			</div>
			<form id="place-form" hx-post="/ui/save-place" hx-sync="#editor-sync:replace">
				<label class="form-label" for="place-search">搜索真实地点</label>
				<div class="dialog-search live-search">
					@Icon("MagnifyingGlass", 19)
					<input name="query" id="place-search" value={ v.Editor.Query } maxlength="100" autocomplete="off" placeholder="输入地点，建议加上城市名" data-search-on-enter/>
					<button type="button" hx-post="/ui/search-editor" hx-include="#workspace-meta, #place-form" hx-sync="#editor-sync:replace" hx-disabled-elt="this">
						搜索
						<span class="htmx-indicator">…</span>
					</button>
				</div>
				<div class="place-choices" aria-label="高德地点搜索结果">
					for i,p := range v.Editor.Choices {
						<button type="button" class={ "place-choice",templ.KV("selected",v.Editor.Selected!=nil&&v.Editor.Selected.Point==p.Point) } hx-post="/ui/select-place" hx-include="#workspace-meta, #place-form" hx-vals={ Values("choice", Number(i)) }>
							@Icon("MapPin", 19)
							<span class="place-result-copy"><strong>{ p.Name }</strong><small>{ p.Address }</small></span>
							if v.Editor.Selected!=nil&&v.Editor.Selected.Point==p.Point {
								@Icon("Check", 18)
							}
						</button>
					}
					if len(v.Editor.Choices)==0 {
						<p class="search-empty">
							if v.Editor.Searched {
								没有找到地点，换个名称或加上城市再试。
							} else {
								搜索后选择准确地址，也可以在地图上选点。
							}
						</p>
					}
				</div>
				<button type="button" class="map-pick-action" hx-post="/ui/start-pick" hx-include="#workspace-meta, #place-form">
					@Icon("Crosshair", 19)
					在地图上选点
					@Icon("ArrowRight", 17)
				</button>
				if v.Editor.Selected!=nil {
					<div class="chosen-position live-chosen">
						@Icon("Check", 16)
						<span>已选择：{ v.Editor.Selected.Name }<small>{ v.Editor.Selected.Address }</small></span>
					</div>
				}
				<label class="form-label" for="place-name">显示名称 <span class="optional-label">可选</span></label><input class="form-input" id="place-name" name="name" value={ v.Editor.Name } maxlength="32" placeholder="留空使用地点名称"/>
				if v.Editor.Error!="" {
					<p class="form-error" role="alert">{ v.Editor.Error }</p>
				}
				<div class="dialog-actions">
					<button type="button" class="secondary-button" hx-post="/ui/close-editor">取消</button>
					<button type="submit" class="primary-button">
						if v.Editor.ID!="" {
							保存修改
						} else {
							添加{ v.Editor.KindName() }
						}
					</button>
				</div>
			</form>
		</dialog>
	}
}

templ Picker(v View) {
	if v.Picking {
		<div class="pick-banner" role="status">
			@Icon("Crosshair", 18)
			<span>{ pickLabel(v) }</span><button type="button" hx-post="/ui/cancel-pick" hx-sync="#editor-sync:replace">取消选点</button>
		</div>
	}
}

templ Notice(v View) {
	if v.Toast!="" {
		<div class="toast" role="status">
			@Icon("Info", 18)
			<span>{ v.Toast }</span>
			if v.CanUndo {
				<button type="button" hx-post="/ui/undo" hx-sync="#route-sync:replace">撤销</button>
			}
			<button type="button" class="icon-button" aria-label="关闭提示" hx-post="/ui/dismiss-toast">
				@Icon("X", 16)
			</button>
		</div>
	}
}

templ Updates(v View, targets []string) {
	for _,target := range targets {
		<div id={ target } hx-swap-oob="outerHTML">
			switch target {
				case "origins":
					@Origins(v)
				case "search":
					@Search(v)
				case "preferences":
					@Preferences(v)
				case "results":
					@Results(v)
				case "route-options":
					@Options(v)
				case "modal":
					@Modal(v)
				case "picker-banner":
					@Picker(v)
				case "notice":
					@Notice(v)
			}
		</div>
	}
}
